<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1;">
        <ui:VisualElement name="PlayerStatus" style="flex-grow: 0; position: absolute; top: 40px; left: 60px; right: auto; bottom: auto; width: 310px; height: 160px;">
            <ui:VisualElement name="HealthManaArea" style="flex-grow: 0; height: 60px; align-self: auto; align-items: center; justify-content: center; background-image: none; background-size: 100% 100%; background-color: rgb(0, 0, 0);">
                <ui:VisualElement name="HPBackground" style="flex-grow: 1; width: 100%; padding-top: 6px; padding-right: 6px; padding-bottom: 3px; padding-left: 6px; justify-content: center; align-items: flex-start; height: 33px;">
                    <ui:VisualElement name="HP" style="flex-grow: 1; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; width: 100%; color: rgb(211, 64, 64); background-color: rgb(211, 64, 64); left: auto; right: auto; top: auto;"/>
                    <ui:Label text="100/100" name="HPText" style="color: rgb(255, 255, 255); -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); position: absolute; top: 0; left: 0; bottom: 0; right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 1px; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 27px; text-shadow: 2.4px 2.4px 0 rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/Font/x10y12pxDenkiChipHangul.ttf?fileID=12800000&amp;guid=e1de80db83966584ab1b56b70ca9f544&amp;type=3#x10y12pxDenkiChipHangul&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="MPBackground" style="flex-grow: 1; width: 100%; padding-top: 3px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; justify-content: center; align-items: flex-start; height: 27px;">
                    <ui:VisualElement name="MP" style="flex-grow: 1; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; width: 100%; color: rgb(56, 56, 56); background-color: rgb(131, 188, 248); left: auto; right: auto; top: auto;"/>
                    <ui:Label text="50/50" name="MPText" style="color: rgb(255, 255, 255); -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); position: absolute; top: 0; left: 0; bottom: 4px; right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px; text-shadow: 1.8px 1.8px 0 rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/Font/x10y12pxDenkiChipHangul.ttf?fileID=12800000&amp;guid=e1de80db83966584ab1b56b70ca9f544&amp;type=3#x10y12pxDenkiChipHangul&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="DashArea" style="flex-grow: 0; height: 33px; align-self: auto; align-items: flex-start; justify-content: flex-start; background-image: none; margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0; padding-top: 3px; padding-bottom: 3px; padding-left: 5px; padding-right: 5px; white-space: nowrap; flex-direction: row; width: 60%;"/>
            <ui:VisualElement name="PotionArea" style="flex-grow: 0; height: auto; align-self: auto; align-items: auto; justify-content: flex-start; background-image: none; width: 50%; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; flex-direction: row; left: 0;">
                <ui:VisualElement name="PotionSlot" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprite/UI/HUDSlotBase.png?fileID=2800000&amp;guid=fe2cf75a009b7f44ba4cc633814be4ab&amp;type=3#HUDSlotBase&quot;); width: 64px; height: 64px; left: 0;">
                    <ui:VisualElement name="SlotBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprite/UI/QuickSlotIcon.png?fileID=2800000&amp;guid=663abe9c176dc1446a8d38bd4cb9dcc8&amp;type=3#QuickSlotIcon&quot;); width: 100%; height: 100%; -unity-background-image-tint-color: rgb(65, 67, 80); position: relative; align-items: center; justify-content: center;">
                        <ui:VisualElement name="PotionIcon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprite/UI/RedPotion1.png?fileID=2800000&amp;guid=c3056f9329111e64a98533360f180238&amp;type=3#RedPotion1&quot;); width: 58px; height: 52px; align-self: auto; align-content: auto; position: relative; left: 0; top: 0; right: auto; bottom: 0; -unity-background-scale-mode: stretch-to-fill;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="PotionUseButton" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprite/UI/Mini_Button_KeyBoard_Small.png?fileID=-212833565271140980&amp;guid=b99490ce7e3573248bacd0ed681123cb&amp;type=3#Mini_Button_KeyBoard_Small_32&quot;); position: absolute; left: -4px; bottom: -4px; width: 28px; height: 28px;"/>
                </ui:VisualElement>
                <ui:Label text="1" name="PotionCount" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; left: 8px; align-self: center; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Font/x10y12pxDenkiChipHangul.ttf?fileID=12800000&amp;guid=e1de80db83966584ab1b56b70ca9f544&amp;type=3#x10y12pxDenkiChipHangul&quot;); color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ShortcutArea" style="flex-grow: 1; position: absolute; left: 0; bottom: 4px; width: 200px; height: 84px; flex-direction: row;">
            <ui:VisualElement name="InventoryIcon" style="flex-grow: 0; position: relative; left: auto; bottom: auto; background-image: url(&quot;project://database/Assets/Sprite/UI/HUDInventory.png?fileID=2800000&amp;guid=9623ce0af8df1dd478436ca542a4f054&amp;type=3#HUDInventory&quot;); width: 96px; height: 84px;">
                <ui:VisualElement name="InventoryButton" style="flex-grow: 0; position: absolute; bottom: 0; align-self: center; width: 28px; height: 28px; background-image: url(&quot;project://database/Assets/Sprite/UI/Mini_Button_KeyBoard_Small.png?fileID=8173034827499663904&amp;guid=b99490ce7e3573248bacd0ed681123cb&amp;type=3#Mini_Button_KeyBoard_Small_40&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="StatsIcon" style="flex-grow: 0; position: relative; left: auto; bottom: auto; background-image: url(&quot;project://database/Assets/Sprite/UI/HUDStats.png?fileID=2800000&amp;guid=6fe08e4dabc0b4a42945145133e70ecf&amp;type=3#HUDStats&quot;); width: 84px; height: 84px;">
                <ui:VisualElement name="StatsButton" style="flex-grow: 0; position: absolute; bottom: 0; align-self: center; width: 28px; height: 28px; background-image: url(&quot;project://database/Assets/Sprite/UI/Mini_Button_KeyBoard_Small.png?fileID=1932154756822020395&amp;guid=b99490ce7e3573248bacd0ed681123cb&amp;type=3#Mini_Button_KeyBoard_Small_54&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ExperienceBar" style="flex-grow: 1; position: absolute; bottom: 0; width: 100%; background-image: url(&quot;project://database/Assets/Sprite/UI/expbar.png?fileID=7784326442125704170&amp;guid=6f2526326f684d148bee601dcc7c9e2d&amp;type=3#expbar_0&quot;); left: 0; height: 4px; background-repeat: repeat no-repeat; background-size: 10% 4px; -unity-background-image-tint-color: rgb(108, 106, 119); right: auto; background-position-x: left 0;">
            <ui:VisualElement name="Experience" style="flex-grow: 1; background-color: rgb(169, 255, 100); position: relative; left: 0; width: 0%;"/>
            <ui:VisualElement name="ExperienceBarFront" style="flex-grow: 0; position: absolute; left: 0; bottom: 0; width: 100%; height: 4px; background-image: url(&quot;project://database/Assets/Sprite/UI/expbar.png?fileID=7784326442125704170&amp;guid=6f2526326f684d148bee601dcc7c9e2d&amp;type=3#expbar_0&quot;); background-repeat: repeat no-repeat; background-position-x: left 0; background-size: 10% 100%; -unity-background-image-tint-color: rgb(108, 106, 119);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
