<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/InventoryTooltip.uss?fileID=7433441132597879392&amp;guid=5c4209d83940c21468ad16062b044458&amp;type=3#InventoryTooltip"/>
    <ui:VisualElement name="InventoryTooltip" style="width: 530px; flex-direction: column; position: absolute; top: 50%; left: 85%; translate: -50% 0%; height: auto;">
        <ui:VisualElement name="ArtifactTooltip" style="flex-direction: column; background-image: url(&quot;project://database/Assets/Sprite/UI/Inventory/ArtifactTooltip_Base.png?fileID=21300000&amp;guid=bcff45629aab7764eb7aa8cbe1c93261&amp;type=3#ArtifactTooltip_Base&quot;); -unity-background-scale-mode: stretch-to-fill; height: auto; flex-grow: 0; display: flex;">
            <ui:VisualElement name="ArtifactHeader" style="flex-direction: row; min-height: 110px; height: 134px; position: relative; width: 100%; flex-shrink: 0;">
                <ui:VisualElement name="ArtifactHeaderLeft" style="flex-grow: 0; position: absolute; left: 41px; right: 160px; bottom: 42px; top: 0;">
                    <ui:VisualElement name="ArtifactStarArea" style="flex-direction: row; justify-content: center; position: absolute; left: 53%; translate: -50% 0%; align-items: center; top: -5px;"/>
