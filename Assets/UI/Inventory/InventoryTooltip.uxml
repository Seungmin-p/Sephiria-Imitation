                        <ui:Label name="ArtifactName" text="아그마 투영검 190,191번" style="-unity-text-align: middle-center; white-space: normal; color: rgb(255, 210, 0); font-size: 28px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="NameText" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                        <ui:VisualElement name="ArtifactSetInfo" style="flex-direction: row; align-items: center; top: 5px;">
                            <ui:VisualElement name="ArtifactSetIcon" style="width: 28px; height: 28px; background-image: url(&quot;project://database/Assets/Sprite/UI/Inventory/Icon/InventoryAccessory_New_01.png?fileID=2800000&amp;guid=f91d473be4e6bb54898010708488be83&amp;type=3#InventoryAccessory_New_01&quot;);">
                                <Bindings>
                                    <ui:DataBinding property="style.backgroundImage" data-source-path="ArtifactSetIconSprite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:VisualElement>
                            <ui:Label name="ArtifactSetName" text="견고" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(97, 217, 159); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); font-size: 20px; -unity-text-align: middle-left;">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="ArtifactSetNameText" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ArtifactHeaderRight" style="flex-grow: 0; width: 137px; right: 0; position: absolute; bottom: 0; top: 0;">
                    <ui:VisualElement name="ArtifactIconFrame" style="width: auto; height: auto; justify-content: center; align-items: center; position: absolute; left: 24px; top: 28px; right: 31px; bottom: 25px;">
                        <ui:VisualElement name="ArtifactIcon" style="position: relative; top: auto; left: auto; bottom: auto; right: auto; background-image: url(&quot;project://database/Assets/Sprite/Item/Artifact/BladeOfLight.png?fileID=2800000&amp;guid=bf152a5ac4cf98f4aa6df6539bba47e8&amp;type=3#BladeOfLight&quot;); -unity-background-scale-mode: scale-to-fit; translate: 0 0%; width: 100%; height: 100%;">
                            <Bindings>
                                <ui:DataBinding property="style.backgroundImage" data-source-path="IconSprite" binding-mode="ToTarget"/>
                            </Bindings>
