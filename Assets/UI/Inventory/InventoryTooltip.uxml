                    <ui:VisualElement name="ArtifactRestriction" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprite/UI/Inventory/PanelInner_white.png?fileID=21300000&amp;guid=454af50942703b1479d598fa89df6a8d&amp;type=3#PanelInner_white&quot;); height: 70px; -unity-background-image-tint-color: rgba(24, 24, 30, 0.86);">
                        <ui:Label text="&lt;제약&gt;" name="ArtifactRestrictionTitle" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 50%; -unity-text-align: middle-center; color: rgb(255, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); font-size: 20px;"/>
                        <ui:Label text="아티팩트 레벨은 0 이상이어야 함" name="ArtifactRestrictionText" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 50%; -unity-text-align: middle-center; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); font-size: 20px;"/>
