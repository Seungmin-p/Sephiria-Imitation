                        <ui:Label text="-물리 피해 (아이콘) +2(색상)" name="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 20px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
