                    <ui:Label name="ArtifactRarity" text="희귀 아티팩트" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(160, 160, 160); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); font-size: 20px;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="ArtifactRarityText" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label name="ArtifactSubDescription" text="190번째. 형체는 검과 흡사하다. 에너지는 대칭적인 형태로만 드러나며, 칼날 자체는 나타나지 않는다. -아그마" enable-rich-text="true" style="white-space: normal; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); width: 390px; color: rgb(144, 204, 203); font-size: 20px;">
