                    <Bindings>
                        <ui:DataBinding property="style.display" data-source-path="RestrictionVisible" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:VisualElement>
                <ui:VisualElement name="ArtifactBodyInfo" style="flex-grow: 1; left: auto; right: auto; position: relative; width: 442px; padding-bottom: 42px; padding-left: 44px;">
                    <ui:Label name="ArtifactUniqueLabel" text="[고유]" style="color: rgb(255, 184, 109); -unity-font-definition: url(&quot;project://database/Assets/Font/Galmuri9.ttf?fileID=12800000&amp;guid=f20e4956ee312394d8429d72de8486b6&amp;type=3#Galmuri9&quot;); -unity-font-style: normal; font-size: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 15px; padding-right: 0; padding-bottom: 0; padding-left: 0; opacity: 1;">
