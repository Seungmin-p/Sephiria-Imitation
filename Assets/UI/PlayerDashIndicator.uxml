<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PlayerDashIndicator" picking-mode="Ignore" style="flex-grow: 0; flex-shrink: 0; padding-left: 4px; padding-right: 4px; padding-top: 3px; padding-bottom: 3px; flex-direction: row; background-color: rgb(0, 0, 0); align-items: center; position: absolute; translate: -50% 0;">
        <ui:VisualElement name="DashSlots" style="flex-grow: 0; height: 9px; flex-direction: row; flex-shrink: 0; align-items: center;"/>
    </ui:VisualElement>
</ui:UXML>
